# Baza (wystarczy postgresql://, aplikacja sama przełączy na sterownik asyncpg)
DATABASE_URL=postgresql://user:haslo@localhost:5432/mojabaza

# Powiadomienia mailowe. Bez SMTP_HOST maile są pomijane (ostrzeżenie w logu).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# true: port 465 = TLS od razu, inne porty = STARTTLS; false: bez szyfrowania
SMTP_TLS=true
# Strefa czasowa dat w mailach
MAIL_TIMEZONE=Europe/Warsaw

# Opcjonalnie: adresy formularza działającego na innej domenie (CORS), po przecinku
CORS_ORIGINS=

# Tylko testy: baza testowa, jej nazwa MUSI zawierać "test" (testy kasują w niej tabele)
TEST_DATABASE_URL=postgresql+asyncpg://user:haslo@localhost:5432/mojabaza_test
